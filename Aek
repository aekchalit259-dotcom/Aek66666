-- สมองปัญญาประดิษฐ์ (AI AEKHUB Logic)
-- =================================================================
local function ProcessAIResponse(question)
    local q = string.lower(question)
    
    -- ภาษาไทย (TH)
    if CurrentLanguage == "TH" then
        if string.find(q, "มีฟังชั่นไรบ้าง") or string.find(q, "มีฟังก์ชั่นไรบ้าง") or string.find(q, "ทำอะไรได้บ้าง") then
            return "มีตามนี้เลยครับ บิน วิ่ง ล่องหน ทะลุ วาร์ป และ แชทAi ครับ"
        elseif string.find(q, "บิน") then
            return "ระบบบินสามารถเปิด-ปิดได้ที่เมนู Rayfield และปรับความเร็วการบินได้ครับ"
        elseif string.find(q, "วิ่ง") or string.find(q, "ความเร็ว") then
            return "ระบบวิ่งเร็วสามารถปรับความเร็ว WalkSpeed ของตัวละครได้ทันทีครับ"
        elseif string.find(q, "วาร์ป") then
            return "ระบบวาร์ปจะย้ายตัวละครไปยังตำแหน่งของเมาส์ทันทีที่กดปุ่มวาร์ปครับ"
        elseif string.find(q, "ใครสร้าง") or string.find(q, "ผู้พัฒนา") then
            return "สคริปต์นี้สร้างโดย เอก (เอกชอบสร้างสคริป) ร่วมกับ AI GIMINI ครับ"
        else
            return "AI AEKHUB ยินดีให้บริการครับ! ตอบได้ทุกคำถาม เกี่ยวกับสคริปต์นี้สั่งการได้เลยครับ (ระบบรองรับทุกแมพ)"
        end

    -- ภาษาอังกฤษ (EN)
    elseif CurrentLanguage == "EN" then
        if string.find(q, "function") or string.find(q, "feature") or string.find(q, "what can you do") then
            return "Available features: Fly, Speed, Invisibility, Noclip, Teleport, and AI Chat."
        else
            return "AI AEKHUB is ready to assist you with any questions regarding this script!"
        end

    -- ภาษาฝรั่งเศส (FR)
    elseif CurrentLanguage == "FR" then
        if string.find(q, "fonction") or string.find(q, "que peux-tu faire") then
            return "Fonctionnalités disponibles : Voler, Vitesse, Invisibilité, Traverser les murs, Téléportation et Chat AI."
        else
            return "AI AEKHUB est à votre service pour répondre à toutes vos questions !"
        end
    end
end

local function SendMessage()
    local text = InputBox.Text
    if text ~= "" then
        AddChatMessage("เอก (คุณ)", text, Color3.fromRGB(255, 255, 255))
        InputBox.Text = ""
        
        task.wait(0.3)
        local response = ProcessAIResponse(text)
        AddChatMessage("AI AEKHUB", response, CurrentThemeColor)
    end
end

SendButton.MouseButton1Click:Connect(SendMessage)
InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SendMessage()
    end
end)

